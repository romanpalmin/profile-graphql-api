# Скопируй в .env и при необходимости поправь.
# Контейнер с базой
POSTGRES_USER=profile
POSTGRES_PASSWORD=profile
POSTGRES_DB=profile
# Порт базы на хосте (если 5432 занят другой базой — поставь, например, 5433)
DB_PORT=5432

# Приложение, запущенное на хосте (npm run start:dev). Порт должен совпадать с DB_PORT.
DATABASE_URL=postgresql://profile:profile@localhost:5432/profile?schema=public
PORT=3000
